# 本機 Secret 值範本；請複製為 config/secrets.yaml 後再填入真實值。
# config/secrets.yaml 已被 .gitignore 排除，絕不可提交或傳送到聊天訊息。
# 這些 key 必須與 catalog 的 discord.bot_secret_ref 完全一致。
secrets:
  discord-leader/token: "REPLACE_WITH_LEADER_DISCORD_BOT_TOKEN"
  discord-researcher/token: "REPLACE_WITH_RESEARCHER_DISCORD_BOT_TOKEN"
  discord-developer/token: "REPLACE_WITH_DEVELOPER_DISCORD_BOT_TOKEN"
  discord-reviewer/token: "REPLACE_WITH_REVIEWER_DISCORD_BOT_TOKEN"

# 僅供對照的 GitLab identity reference；真正憑證請使用既定的外部憑證機制。
identity_refs:
  - gitlab-bootstrap
